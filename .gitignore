# ---------------------------------------------------------------------------
# Secrets and site-specific config. NEVER commit these.
# ---------------------------------------------------------------------------
config.env
*.env
!*.env.example
!tests/config.test.env.example

# The DID pool and the LRN blocklist hold real purchased numbers and real
# carrier rate-deck data. Only the .example files are tracked.
dids.csv
blocklist.csv
!dids.csv.example
!blocklist.csv.example

# Rate decks exported from the carrier portal. Never commit one.
decks/
*rate-deck*.csv
*rate-deck*.xlsx
*ShortDuration*.csv
*ShortDuration*.xlsx
!tools/testdata/sample-rate-deck.csv

*.key
*.pem
*.crt
*.p12
*.pfx
*.der
*.jks
.htpasswd
secrets/

# ---------------------------------------------------------------------------
# Rendered Asterisk configuration. Only the .tpl files are tracked; the
# rendered .conf files contain real customer and carrier IPs.
# ---------------------------------------------------------------------------
asterisk/*.conf
rendered/
/etc-asterisk-backup/

# ---------------------------------------------------------------------------
# Call detail records, SIP traces, logs. Contain phone numbers and IPs.
# ---------------------------------------------------------------------------
cdr/
*.log
*.pcap
*.pcap.*
siptrace/
tests/results/
RUNBOOK-acceptance.generated.md

# ---------------------------------------------------------------------------
# Test fixtures are FAKE numbers and are deliberately tracked. Whitelisted
# here so no broader rule above can swallow them.
# ---------------------------------------------------------------------------
!tests/sipp/*.csv
!tests/sipp/*.xml

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
*.swp
*~
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python bytecode from tools/
__pycache__/
*.pyc

# FracTEL order-run state: contains purchased DIDs, not secrets, but
# it is site-specific and belongs on the box that ran the order.
fractel-order-state.json

# Carrier CDR exports. 25MB of third-party call records (240k numbers
# belonging to other FracTEL customers) -- never belongs in this repo, and an
# untracked file here also makes verify-deployment.sh --write stamp the box
# "WORKING TREE DIRTY".
fractel-*.csv
