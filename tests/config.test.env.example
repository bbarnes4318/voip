# ===========================================================================
# tests/config.test.env — configuration for the on-box acceptance suite.
#
#     cp tests/config.test.env.example tests/config.test.env
#
# This renders an SBC that talks to a local SIPp stub instead of the real
# FracTEL trunk, with deliberately tiny caps so criteria 6 and 7 prove
# themselves in seconds rather than minutes.
#
# APPLYING THIS REPLACES THE RUNNING ASTERISK CONFIGURATION.
# Use tests/apply-test-config.sh and tests/restore-prod-config.sh — they
# handle the backup and restore. Never run this on a box carrying live
# customer traffic.
#
# Every address here is in 127.0.0.0/8. The whole /8 is bound to lo on Linux,
# so each of these is a distinct, bindable local source address — which is
# what lets one box play customer 1, customer 2, the carrier, and an
# unauthorized third party all at once.
#
# The addresses are deliberately all different. Giving the customer and the
# carrier the same address would make two `type=identify` sections match the
# same source, and which endpoint won would be undefined.
# ===========================================================================

# Asterisk binds 0.0.0.0:5060, so it answers on 127.0.0.1.
SBC_PUBLIC_IP=127.0.0.1
SBC_IFACE=lo

# Not used by the suite (the firewall is not applied for tests) but render.sh
# requires it to be set and not a placeholder.
ADMIN_SSH_IP=127.0.0.1
SSH_PORT=22

# The two "customer" source addresses. run-acceptance.sh binds SIPp to these.
PK_CLIENT_IP_1=127.0.0.11
PK_CLIENT_IP_2=127.0.0.12
PK_CLIENT_MEDIA_EXTRA=
SIP_PORT=5060

# The FracTEL stand-in: tests/sipp/uas-fractel-stub.xml listening here.
# Single gateway keeps the failover path deterministic during testing; add
# more entries to exercise it.
FRACTEL_PROXY_IPS=127.0.0.20:5080
FRACTEL_DOMAIN=127.0.0.1
DIAL_TIMEOUT=15
FRACTEL_QUALIFY_FREQ=15

# Small caps so the capacity criteria are provable quickly.
#   crit 6: the 4th simultaneous call must get 503
#   crit 7: a burst well above 5/s must get throttled
MAX_CONCURRENT_PER_IP=3
MAX_CPS=5

# All fraud controls ON — the suite is here to prove they work.
NANP_ONLY=true
BLOCK_HIGH_RISK_NPA=true
BLOCKED_NPAS=242,246,264,268,284,345,441,473,649,658,664,721,758,767,784,809,829,849,868,869,876,900
BLOCK_976=true
VALIDATE_CALLERID=true
NORMALIZE_CALLERID=false

ENABLE_G729=false

RTP_START=10000
RTP_END=20000

CDR_CSV_PATH=/var/log/asterisk/cdr-custom/sbc.csv
PG_DSN=

SIP_TRACE_ENABLED=false
LOG_RETAIN_DAYS=7
CDR_RETAIN_DAYS=7

ASTERISK_INSTALL_METHOD=package
SBC_NAT_LOCAL_NET=

# ---------------------------------------------------------------------------
# Suite-only settings
# ---------------------------------------------------------------------------

# Source address the unauthorized-origin test binds to. Must NOT appear
# anywhere above, or it would be permitted and the test would be meaningless.
TEST_UNAUTHORIZED_IP=127.0.0.99

# Set to an address on ANOTHER machine to run criterion 3 for real against
# the host firewall. Left empty, the driver SKIPs the firewall half of
# criterion 3 loudly rather than reporting a pass it cannot justify.
# See tests/README.md.
OFFBOX_PROBE_IP=
