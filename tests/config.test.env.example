# ===========================================================================
# tests/config.test.env — configuration for the on-box acceptance suite.
#
#     cp tests/config.test.env.example tests/config.test.env
#
# This renders an SBC that talks to a local SIPp stub instead of the real
# FracTEL trunk, with deliberately tiny caps so criteria 6 and 7 prove
# themselves in seconds rather than minutes.
#
# APPLYING THIS REPLACES THE RUNNING ASTERISK CONFIGURATION.
# Use tests/apply-test-config.sh and tests/restore-prod-config.sh — they
# handle the backup and restore. Never run this on a box carrying live
# customer traffic.
#
# Every address here is in 127.0.0.0/8. The whole /8 is bound to lo on Linux,
# so each of these is a distinct, bindable local source address — which is
# what lets one box play customer 1, customer 2, the carrier, and an
# unauthorized third party all at once.
#
# The addresses are deliberately all different. Giving the customer and the
# carrier the same address would make two `type=identify` sections match the
# same source, and which endpoint won would be undefined.
# ===========================================================================

# Asterisk binds 0.0.0.0:5060, so it answers on 127.0.0.1.
SBC_PUBLIC_IP=127.0.0.1
SBC_IFACE=lo

# Not used by the suite (the firewall is not applied for tests) but render.sh
# requires it to be set and not a placeholder.
ADMIN_SSH_IP=127.0.0.1
SSH_PORT=22

# The "customer" source addresses. run-acceptance.sh binds SIPp to the first
# (every criterion) and the second (criterion 6b, which proves the concurrency
# cap is per-IP and not global), and criterion 1 checks that one endpoint
# exists per entry. Two is the minimum; add more to mirror production.
PK_CLIENT_IPS=127.0.0.11,127.0.0.12
PK_CLIENT_MEDIA_EXTRA=
SIP_PORT=5060

# The FracTEL stand-ins: six of them, one per address, each running
# tests/sipp/uas-fractel-stub.xml. run-acceptance.sh starts one stub per entry
# in this list and shuts them all down again on exit.
#
# SIX, not one, because criterion 17 is "600 calls distribute roughly evenly
# across all six gateways". With a single gateway that criterion is
# unprovable and the round-robin could be silently broken.
#
# Distinct ADDRESSES rather than distinct ports on 127.0.0.1: render.sh emits
# one type=identify per gateway matching on IP, and six identify sections all
# matching 127.0.0.1 is undefined behaviour — whichever endpoint wins is an
# implementation detail and a test built on it proves nothing.
FRACTEL_PROXY_IPS=127.0.0.20:5080,127.0.0.21:5080,127.0.0.22:5080,127.0.0.23:5080,127.0.0.24:5080,127.0.0.25:5080
FRACTEL_DOMAIN=127.0.0.1
DIAL_TIMEOUT=15
FRACTEL_QUALIFY_FREQ=15

# Caps small enough that the capacity criteria prove themselves in seconds,
# large enough that the volume criteria (13 and 17, 1000 calls) are not
# throttled into meaninglessness by the very limits they are not testing.
#   crit 6:  the 11th simultaneous call must get 503
#   crit 7:  a burst well above 20/s must get throttled
#   crit 13: 1000 calls at 12/s needs headroom under both of the above
MAX_CONCURRENT_PER_IP=10
MAX_CPS=20

# All fraud controls ON — the suite is here to prove they work.
NANP_ONLY=true
BLOCK_HIGH_RISK_NPA=true
BLOCKED_NPAS=242,246,264,268,284,345,441,473,649,658,664,721,758,767,784,809,829,849,868,869,876,900
BLOCK_976=true

# Advisory, matching the production default. The customer's caller ID is
# discarded and replaced on every call, so a malformed one is logged at
# WARNING and the call proceeds — which is what criteria 12 and 12b test.
#
# The two caller-ID rejection tests in the suite need the OTHER behaviour, so
# they SKIP while this is false and tell you how to run them. A skip is not a
# pass; flip this to true and re-run to exercise the 403 path.
VALIDATE_CALLERID=false
NORMALIZE_CALLERID=false

# ---------------------------------------------------------------------------
# DID pool and blocklist
# ---------------------------------------------------------------------------
# Fake numbers in the 555-01XX fiction range. See tests/dids.test.csv.
DIDS_CSV=tests/dids.test.csv
BLOCKLIST_CSV=tests/blocklist.test.csv
OVERFLOW_MIN=20

# Five, so criterion 14 is literal: with the cap set to 5, the 6th call that
# would use a given DID has to select a different one. NPA 989 in
# dids.test.csv holds exactly one number, which makes that reachable in six
# calls instead of 201.
DID_DAILY_CAP=5

# ---------------------------------------------------------------------------
# Transfer-leg detection
# ---------------------------------------------------------------------------
TRANSFER_DETECT=true
TRANSFER_TOLLFREE_NPAS=800,833,844,855,866,877,888

# THE ACD THRESHOLD IS SCALED FOR TEST RUNTIME. Production is 60.
#
# Criterion 19 is "3 calls at 90s each, the 4th is flagged" — 270 seconds of
# waiting to exercise an integer comparison. With the threshold at 3s the
# suite places 6-second calls instead and runs the identical code path
# through the identical branch.
#
# TRANSFER_MIN_CALLS is NOT scaled. It stays at 3 because 3 is the number
# that was validated against production CDRs, and criteria 19 and 21 exist
# specifically to prove the boundary between 2 and 3.
TRANSFER_MIN_CALLS=3
TRANSFER_MIN_ACD=3
TRANSFER_EXPIRE_DAYS=30

ENABLE_G729=false

RTP_START=10000
RTP_END=20000

CDR_CSV_PATH=/var/log/asterisk/cdr-custom/sbc.csv
PG_DSN=

SIP_TRACE_ENABLED=false
LOG_RETAIN_DAYS=7
CDR_RETAIN_DAYS=7

ASTERISK_INSTALL_METHOD=package
SBC_NAT_LOCAL_NET=

# ---------------------------------------------------------------------------
# Suite-only settings
# ---------------------------------------------------------------------------

# Source address the unauthorized-origin test binds to. Must NOT appear
# anywhere above, or it would be permitted and the test would be meaningless.
TEST_UNAUTHORIZED_IP=127.0.0.99

# Set to an address on ANOTHER machine to run criterion 3 for real against
# the host firewall. Left empty, the driver SKIPs the firewall half of
# criterion 3 loudly rather than reporting a pass it cannot justify.
# See tests/README.md.
OFFBOX_PROBE_IP=

# Criteria 13 and 17 — call volume and the rate to place it at.
#
# 1000 calls at 12/s is about 90 seconds. Criterion 13 asks for 1000 and
# criterion 17 asks for 600; both are evaluated from the same run rather than
# placing 1600 calls to answer two questions about the same mechanism.
#
# The rate must stay under MAX_CPS or the CPS limiter starts refusing calls
# and the distribution is measured over a smaller sample than you think. The
# driver checks this and warns.
#
# Drop to 200 for a quick pass; the evenness assertions still hold, they are
# just noisier. Do NOT report a 200-call run as satisfying criterion 13.
ACCEPT_VOLUME_CALLS=1000
ACCEPT_VOLUME_CPS=12
