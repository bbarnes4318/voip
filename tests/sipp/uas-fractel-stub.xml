<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  uas-fractel-stub.xml — stands in for the FracTEL trunk.

  Answers whatever the SBC sends it, echoes RTP back, and responds to BYE.
  Lets the full customer -> SBC -> carrier path be exercised without spending
  real money, without touching the live trunk, and without FracTEL's fraud
  system seeing a burst of test traffic from a brand new subaccount.

  Point the SBC at this by rendering from tests/config.test.env, which sets
  FRACTEL_PROXY_IPS=127.0.0.20:5080.

  Run with RTP echo so criterion 10 (media transits the SBC) can be observed:

    sipp -sf uas-fractel-stub.xml -i 127.0.0.20 -p 5080 -rtp_echo -nostdin

  Also answers the OPTIONS pings that pjsip.conf's qualify_frequency
  generates, so `pjsip show contacts` reports the stub gateway as Avail and
  acceptance criterion 1 can be demonstrated without the real carrier.
-->

<scenario name="FracTEL stub">

  <!-- Keep the qualify OPTIONS pings happy so the AOR shows Avail. -->
  <recv request="OPTIONS" optional="true" next="options_reply"/>

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <!-- Realistic ring delay, so answered calls have a distinguishable
       answer timestamp in the CDR. -->
  <pause milliseconds="2000"/>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 8 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15

    ]]>
  </send>

  <recv request="ACK" optional="true" rtd="true" crlf="true"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <timewait milliseconds="4000"/>

  <label id="options_reply"/>
  <send next="0">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTagOpt[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="10, 50, 100, 200, 500, 1000"/>

</scenario>
