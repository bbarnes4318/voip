<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  uas-fractel-stub-fast.xml — the FracTEL trunk, for volume runs.

  Identical to uas-fractel-stub.xml except that it answers immediately
  instead of ringing for two seconds first, and it does not echo RTP.

  Used by acceptance criteria 13 and 17 only. Those place 1000 calls to
  measure which DID and which gateway each one selected; a realistic ring
  delay would add half an hour and prove nothing about either.

  Everything the suite asserts about media (criterion 10) and about answer
  timestamps (criterion 8) uses the NORMAL stub. Do not swap this one in for
  those — a stub that answers in zero milliseconds cannot demonstrate a
  distinguishable answer timestamp, and one that does not echo RTP cannot
  demonstrate that media transits the box.

  Still answers OPTIONS, so qualify keeps the AOR Avail while it is running.

    sipp -sf uas-fractel-stub-fast.xml -i 127.0.0.20 -p 5080 -nostdin
-->

<scenario name="FracTEL stub - immediate answer">

  <recv request="OPTIONS" optional="true" next="options_reply"/>

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 8 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15

    ]]>
  </send>

  <recv request="ACK" optional="true" rtd="true" crlf="true"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <timewait milliseconds="1000"/>

  <label id="options_reply"/>
  <send next="0">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTagOpt[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="10, 50, 100, 200, 500, 1000"/>

</scenario>
