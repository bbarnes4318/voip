# ===========================================================================
# SBC configuration — copy to config.env and fill in.
#
#     cp config.env.example config.env
#     chmod 600 config.env
#     $EDITOR config.env
#
# config.env is gitignored. Every value below is a placeholder using RFC 5737
# documentation addresses. NONE of these are real.
#
# Everything in asterisk/*.tpl, firewall.sh, killswitch.sh and monitor.sh
# renders from this file. There is no IP hardcoded anywhere else in the repo.
# ===========================================================================


# ---------------------------------------------------------------------------
# Identity of this box
# ---------------------------------------------------------------------------

# The SBC's single public IPv4. This is the ONE address FracTEL authorizes on
# the trunk, and the address both customer IPs converge into. Hetzner assigns
# it to the primary interface; there is no NAT in front of it.
#
# If this box IS behind NAT (it should not be), see SBC_NAT_* at the bottom.
SBC_PUBLIC_IP=203.0.113.10

# Interface the public IP lives on. Used by firewall.sh and the SIP trace
# capture. `ip -4 -o addr show` will tell you. Leave as "auto" to detect the
# interface holding SBC_PUBLIC_IP.
SBC_IFACE=auto


# ---------------------------------------------------------------------------
# Administrative access
# ---------------------------------------------------------------------------

# Your IP, and the ONLY source allowed to reach SSH. Default-DROP applies to
# everything else including SSH — lock this in before you run firewall.sh or
# you will lock yourself out. Comma-separated if you need more than one.
#
# firewall.sh refuses to run if this is unset, still the placeholder value, or
# does not include the address you are currently connected from.
ADMIN_SSH_IP=203.0.113.200

# SSH port. Change if you moved it off 22.
SSH_PORT=22


# ---------------------------------------------------------------------------
# Customer side (wholesale VOIP company, Pakistan)
# ---------------------------------------------------------------------------

# The customer's signaling IPs, comma-separated. Each entry gets its own PJSIP
# endpoint, its own line in the SIP ACL and the firewall, its own concurrency
# counter, and its own value in the CDR's customer_endpoint column. Adding an
# address is this one line — render.sh generates everything downstream.
#
# ORDER IS AN IDENTITY. Entry 1 is pkclient1, entry 2 is pkclient2, and so on,
# and that name is what the CDR bills on and what the concurrency cap counts.
# APPEND to this list. Reordering it, or deleting from the middle, renames the
# endpoints after the gap and re-attributes their history to the wrong
# address. render.sh warns if a render would move an existing pkclientN.
#
# Signaling only. If the customer sources RTP from a different address block,
# add it to PK_CLIENT_MEDIA_EXTRA below or their audio will be dropped by the
# firewall.
PK_CLIENT_IPS=198.51.100.21,198.51.100.22,198.51.100.23

# The pre-list spelling. Still read when PK_CLIENT_IPS is empty, so an old
# config.env keeps working, but new addresses go in the list above.
#PK_CLIENT_IP_1=198.51.100.21
#PK_CLIENT_IP_2=198.51.100.22

# Optional: extra source addresses/CIDRs allowed to send RTP only (never SIP).
# Comma-separated. Leave empty unless the customer tells you their media
# originates somewhere other than their signaling IPs.
PK_CLIENT_MEDIA_EXTRA=

# SIP port the customer sends to.
SIP_PORT=5060


# ---------------------------------------------------------------------------
# FracTEL side (outbound trunk)
# ---------------------------------------------------------------------------

# FracTEL's outbound proxy IPs, comma-separated. One PJSIP endpoint/aor/
# identify is generated per entry and the dialplan fails over across all of
# them in order. The count is data-driven — add or remove entries freely.
#
# Optional :port suffix per entry, e.g. 192.0.2.31:5060. Defaults to 5060.
#
# Get the current list from your FracTEL subaccount portal. Do not guess, and
# do not reuse the list from the hoppwhistle box — this is a separate
# subaccount and the proxy set can differ.
FRACTEL_PROXY_IPS=192.0.2.31,192.0.2.32,192.0.2.33,192.0.2.34,192.0.2.35,192.0.2.36

# Domain to put in the From/To host portion toward FracTEL. Most static-IP
# FracTEL trunks accept the SBC's own IP here, which is the default when this
# is left empty. Set it only if FracTEL tells you to use a specific realm.
FRACTEL_DOMAIN=

# Seconds to wait for the far end to answer before trying the next gateway.
DIAL_TIMEOUT=60

# Maximum INVITEs toward the carrier per customer call, INCLUDING the first.
#
# This is a hard cap on ring depth, and it is not the same thing as the gateway
# count. Every gateway in FRACTEL_PROXY_IPS is a proxy on ONE subaccount
# reaching ONE upstream, so a rejection that came from the far end comes back
# identically from every one of them. Walking the whole ring buys nothing and
# costs a multiple of the INVITE volume.
#
# Measured on this box over 2026-08-11..12: with a 7-deep ring, 9,494 customer
# calls produced 23,545 INVITEs (2.48x), and 26.6% of dialled calls burned the
# entire ring before failing. Of the calls that failed over even once, 60%
# went on to exhaust every remaining gateway.
#
# 2 means: try once, try one alternate, stop. Raising this multiplies the CPS
# the carrier sees and inflates their view of your traffic quality, which
# matters more than usual while a compliance review is open.
#
# Effective value is min(MAX_ROUTE_ATTEMPTS, number of gateways) — with a
# single gateway there is nothing to fail over to and the cap becomes 1.
MAX_ROUTE_ATTEMPTS=2

# Seconds under which a failure with NO ringing is treated as a network-level
# reject rather than a human declining the call.
#
# DIALSTATUS=CHANUNAVAIL is ambiguous and that ambiguity was live harm. A 603
# Decline — a real consumer pressing decline — maps to AST_CAUSE_CALL_REJECTED
# and surfaces as CHANUNAVAIL, which is one of the two conditions that walked
# the gateway ring. So the box was redialling people who had just rejected it,
# which is the exact behaviour the failover comment says it prevents.
#
# The split is on whether the call ever rang: no ringing and a failure faster
# than this is the trunk saying no, and is retried. Anything that rang is a
# person saying no, and is never retried.
FAST_REJECT_SECONDS=2

# How often to qualify (OPTIONS ping) the FracTEL gateways, in seconds.
# healthcheck.sh reads reachability from this.
FRACTEL_QUALIFY_FREQ=30


# ---------------------------------------------------------------------------
# Traffic controls — this is where fraud gets stopped
# ---------------------------------------------------------------------------

# Simultaneous calls allowed per customer endpoint (so per customer IP).
# Enforced with GROUP()/GROUP_COUNT(). Over-cap calls get 503 and a loud
# NOTICE in the log. 50 is the test-day value; raise deliberately.
MAX_CONCURRENT_PER_IP=50

# Calls per second, counted across BOTH customer IPs combined. Over-limit
# calls get 503. This exists to stop the customer's dialer from tripping
# FracTEL's fraud system and killing the trunk mid-test.
MAX_CPS=10

# Destination allowlist. true = only NANP (_1NXXNXXXXXX / _NXXNXXXXXX,
# normalized to 11 digits) is dialable; everything else gets 503.
#
# This is the single most valuable control on the box. Leave it on. With it
# off, a compromised customer dialer can bill five figures of premium-rate
# international to your FracTEL account overnight.
NANP_ONLY=true

# NANP-only is NOT sufficient on its own. The Caribbean is inside the NANP
# and is the classic IRSF / wangiri fraud destination — +1-876 Jamaica,
# +1-809/829/849 Dominican Republic, +1-284 BVI and friends all match
# _1NXXNXXXXXX perfectly while costing many dollars a minute.
#
# true = additionally reject the NPAs in BLOCKED_NPAS below.
# The customer dials US consumers, so this should stay on.
BLOCK_HIGH_RISK_NPA=true

# Space- or comma-separated NPAs rejected when BLOCK_HIGH_RISK_NPA=true.
# Default covers non-US/Canada NANP territories plus 900 premium.
# US territories (787/939 Puerto Rico, 340 USVI, 671 Guam) are NOT in this
# list — they are ordinary US destinations.
BLOCKED_NPAS=242,246,264,268,284,345,441,473,649,658,664,721,758,767,784,809,829,849,868,869,876,900

# Reject an NXX (the second triplet) of 976 — US domestic premium-rate.
BLOCK_976=true

# ---------------------------------------------------------------------------
# Caller ID
#
# THE SBC ASSIGNS CALLER ID. The customer's value is discarded on every call.
#
# This reverses the original design, in which the customer set their own CID.
# A customer's ViciDial put 50,864 calls on one DID in an afternoon and
# tripped a carrier fraud alert: their dialer matched CID to destination area
# code and silently fell back to a single default number when no match
# existed. Caller ID is no longer theirs to get wrong.
#
# What the customer sends is recorded in the CDR (caller_id) and in the log,
# and never reaches FracTEL.
# ---------------------------------------------------------------------------

# Validation of the CUSTOMER'S caller ID. This is now advisory: their value is
# discarded either way, so rejecting the call over it throws away revenue for
# a field we never use.
#
#   false = (default) accept the call, replace the CID, and log a WARNING
#           SBC-CID-INVALID with the value they sent and their source IP. That
#           is the signal that their dialer has started emitting garbage,
#           without dropping the traffic.
#   true  = additionally refuse the call with 403 before it is placed.
#           The rejection path is still there and still works; it is just no
#           longer the default.
#
# The guard that matters now is on the way out, and it is not optional: if the
# DID this SBC selected is empty or malformed, the call is refused with 503
# and an ERROR is logged. A call never leaves here with customer-supplied CID.
VALIDATE_CALLERID=false

# Retained for the 403 path only: when VALIDATE_CALLERID=true, normalise a
# valid 10-digit customer CID to 11 digits before validating it. Has no effect
# on what is sent to FracTEL — that is always the selected DID.
NORMALIZE_CALLERID=false


# ---------------------------------------------------------------------------
# DID pool — the numbers this SBC asserts as caller ID
# ---------------------------------------------------------------------------

# CSV of the DIDs we own: two columns, "npa,did".
#
#   npa       3-digit destination area code this DID should be used for, or
#             the literal OVERFLOW for the fallback pool
#   did       10 or 11 digits, normalised to 11 on load
#
# Per call: look up the destination NPA, pick from that NPA's pool, and fall
# to OVERFLOW when the NPA has no pool or every DID in it is capped out.
#
# This file holds real purchased numbers. It is gitignored — only
# dids.csv.example is tracked.
DIDS_CSV=dids.csv

# The OVERFLOW pool must hold at least this many numbers. render.sh REFUSES to
# render below it, deliberately: a small overflow pool degrades into the
# single-default-number behaviour that caused the incident this build exists
# to prevent. Raise it if you like; lowering it is how the bug comes back.
OVERFLOW_MIN=20

# Calls allowed on one DID per calendar day, local time. Enforced in the call
# path — a DID at its cap is out of rotation until local midnight, not flagged
# in a report the next morning.
#
# When every DID in an NPA pool is capped, the call falls to OVERFLOW and logs
# WARN. When OVERFLOW is capped out too, the call is refused with 503 and an
# ERROR is logged. There is no unmetered fallback anywhere in this path.
#
# Counters are keyed by date (did_count/<YYYYMMDD>/<did>) in the Asterisk
# database, so they persist across restarts and roll over at local midnight
# with no reset job to fail.
DID_DAILY_CAP=200


# ---------------------------------------------------------------------------
# Transfer-leg detection
#
# The rewrite above is correct for prospect dials and WRONG for transfer legs.
# When an agent bridges a live prospect to the US buyer, the buyer has to see
# the PROSPECT's number — that is their callback path and their CRM record.
# ViciDial already sets caller ID correctly on those legs; rewriting it would
# show the buyer a stranger.
#
# Detection is on the DESTINATION, never on caller ID. The customer sends
# arbitrary caller ID on every call — that is the entire reason this SBC
# exists — so a caller-ID-based rule would be trivially defeated by the exact
# misconfiguration it is meant to survive.
#
# On a detected transfer leg the customer's caller ID is passed through
# untouched to From, P-Asserted-Identity and Remote-Party-ID, no DID is drawn
# from the pool, and no daily cap is consumed.
#
# The NANP allowlist, the NPA denylist and the high-cost blocklist ALL STILL
# APPLY. A transfer leg is not a trusted call, it is a call whose caller ID we
# do not own.
# ---------------------------------------------------------------------------

# Master switch. false = every call gets the rewrite, which is the pre-transfer
# behaviour.
TRANSFER_DETECT=true

# --- Rule 1: toll-free destination. Stateless, immediate, no state to warm up.
#
# Consumer prospects are never toll-free. Verified against a 53,370-call
# production day: all 15 transfer legs went to two 844 numbers.
#
# This rule costs nothing — it is a membership test on the destination NPA
# that runs before any database read.
TRANSFER_TOLLFREE_NPAS=800,833,844,855,866,877,888

# --- Rule 2: auto-learned, per customer endpoint, per destination.
#
# A destination becomes a transfer destination once it has TRANSFER_MIN_CALLS
# answered calls AND an average duration above TRANSFER_MIN_ACD seconds.
#
# 3 and 60 were validated against two production CDRs: they flag exactly the
# one real buyer line with zero false positives. A threshold of 2 flags six
# destinations, which is too loose. DO NOT LOWER THIS.
TRANSFER_MIN_CALLS=3
TRANSFER_MIN_ACD=60

# A destination is not tracked at all until it has produced one answered call
# longer than TRANSFER_MIN_ACD. Traffic hits roughly 42,000 unique
# destinations a day and only about 80 ever produce a call over a minute;
# tracking every destination would add 20,000+ pointless database writes a day
# for numbers that will never qualify.
#
# Counters are updated in the HANGUP handler, never during call setup, so
# learning cannot add post-dial delay. Detection only ever reads.

# Days of inactivity after which a LEARNED destination is forgotten.
# Destinations pinned with `didctl.sh transfers add` and destinations
# suppressed with `didctl.sh transfers remove` never expire — both are
# deliberate operator decisions and outliving a quiet month is the point.
TRANSFER_EXPIRE_DAYS=30


# ---------------------------------------------------------------------------
# High-cost prefix blocklist — the primary cost control
# ---------------------------------------------------------------------------

# CSV of LRN prefixes to refuse, generated from the carrier rate deck:
#
#     python3 tools/build-blocklist.py --deck ShortDuration.csv --out blocklist.csv
#
# Columns: prefix,rate_per_min,destination. Longest-prefix match against the
# normalised 11-digit destination; a match is refused with 503 and logged at
# WARN with the prefix, the rate and what the call would have cost.
#
# Regenerate after every rate deck update. Gitignored — it is derived from
# carrier pricing. Only blocklist.csv.example is tracked.
#
# render.sh refuses to render if this file is missing. An empty file (header
# row only) renders with a loud warning.
BLOCKLIST_CSV=blocklist.csv


# ---------------------------------------------------------------------------
# Codecs
# ---------------------------------------------------------------------------

# ulaw and alaw are always offered, on both legs, in that order.
#
# true = additionally offer g729 on both legs. Cuts bandwidth roughly 65%.
# This is PASSTHROUGH only — the same codec set is offered on both legs so
# Asterisk bridges natively and never transcodes. Asterisk's bundled g729 is
# passthrough-only anyway; transcoding needs a licensed binary codec that this
# build deliberately does not install.
ENABLE_G729=false


# ---------------------------------------------------------------------------
# RTP
# ---------------------------------------------------------------------------

# Media port range. 10000-20000 gives ~2500 concurrent calls (4 ports/call
# with RTCP on both legs). The firewall opens this range to the customer and
# FracTEL IPs only.
RTP_START=10000
RTP_END=20000


# ---------------------------------------------------------------------------
# CDR
# ---------------------------------------------------------------------------

# CSV is the system of record and is always written. Column order is
# documented in README.md and in asterisk/cdr_custom.conf.tpl.
CDR_CSV_PATH=/var/log/asterisk/cdr-custom/sbc.csv

# Optional Postgres mirror. Leave EMPTY to run CSV-only — the CSV alone is
# sufficient for the test and for answering a traceback.
#
# Format: postgresql://user:password@host:5432/dbname
# If set, install.sh creates the table and a systemd timer ships new CSV rows
# into it. This file is chmod 600 and gitignored; the DSN contains a password.
PG_DSN=


# ---------------------------------------------------------------------------
# SIP tracing / retention
# ---------------------------------------------------------------------------

# true = run a rotating tcpdump of SIP signaling for the test window.
# Traces are what you hand over on a traceback request, and you have 24 hours
# to answer one.
SIP_TRACE_ENABLED=true

# Directory, per-file size cap in MB, and number of files kept. The defaults
# cap disk usage at 100MB * 20 = 2GB.
SIP_TRACE_DIR=/var/log/asterisk/siptrace
SIP_TRACE_FILE_MB=100
SIP_TRACE_KEEP=20

# Days of Asterisk logs and CDR CSV to retain before logrotate discards them.
LOG_RETAIN_DAYS=30
CDR_RETAIN_DAYS=90


# ---------------------------------------------------------------------------
# Install behaviour
# ---------------------------------------------------------------------------

# package = install Asterisk 20 from the distro repo (Debian 12 / Ubuntu 24.04
#           both ship 20.x). Fast, ~2 minutes, and what you want tonight.
# source  = build Asterisk 20 LTS from source. ~30 minutes. Only if the distro
#           package is the wrong major version.
ASTERISK_INSTALL_METHOD=package

# Asterisk version to fetch when ASTERISK_INSTALL_METHOD=source.
ASTERISK_SOURCE_VERSION=20-current


# ---------------------------------------------------------------------------
# NAT — leave these empty on a normal Hetzner box
# ---------------------------------------------------------------------------
# Only set these if the SBC's public IP is NOT bound directly to its
# interface. Setting them when they are not needed causes one-way audio.
SBC_NAT_LOCAL_NET=
