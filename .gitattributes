# Everything that runs on the Linux SBC must have LF endings, regardless of
# what OS the repo was cloned or edited on. A CRLF in install.sh produces
# "bad interpreter: /usr/bin/env bash^M" on test day.
*.sh    text eol=lf
*.tpl   text eol=lf
*.conf  text eol=lf
*.env   text eol=lf
*.example text eol=lf
*.xml   text eol=lf
*.csv   text eol=lf
*.md    text eol=lf
*.service text eol=lf
*.timer text eol=lf
